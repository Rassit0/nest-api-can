PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/db?schema=public"
JWT_SECRET="secret"
APP_TIMEZONE="America/La_Paz"

# Dominios permitidos para CORS (separados por coma)
FRONTEND_URLS="http://localhost:3000,http://localhost:3002"

# Opciones: local o s3 (si no se define, es local)
STORAGE_DRIVER=local

# Si STORAGE_DRIVER=s3, descomentar y configurar lo siguiente:
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=
#
# Ejemplos S3_PUBLIC_URL:
# 1. R2/CDN directo (bucket ya está en la ruta raíz):
# S3_PUBLIC_URL=https://cdn.example.com
# 2. Endpoints que requieren el bucket en el path:
# S3_PUBLIC_URL=https://storage.example.com/{bucket}
# 3. Bucket como subdominio:
# S3_PUBLIC_URL=https://{bucket}.storage.example.com
