import 'dotenv/config';
// @ts-nocheck
import { PrismaClient } from '../src/generated/prisma/client';

const prisma = new PrismaClient();
const API_URL = 'http://localhost:3001/api';

async function fetchAPI(url, options = {}) {
  const res = await fetch(url, {
    headers: { 'Content-Type': 'application/json' },
    ...options
  });
  const data = await res.json().catch(() => null);
  if (!res.ok) {
    const err: any = new Error(data?.message || res.statusText);
    err.response = { status: res.status, data };
    throw err;
  }
  return { data };
}

async function runQA() {
  console.log("=== INICIANDO VALIDACIÓN QA ON-DEMAND ===");
  try {
    console.log("Preparando datos de prueba...");
    const plan = await prisma.paymentPlan.findFirst({ where: { isActive: true } });
    if (!plan) throw new Error("No hay PaymentPlan");

    const person = await prisma.person.create({
      data: {
        name: 'QA Test',
        lastName: 'OnDemand',
        documentNumber: `QA-${Date.now()}`,
        documentType: 'DNI',
        email: `qa-${Date.now()}@test.com`,
        birthDate: new Date('2000-01-01'),
      }
    });
    
    const student = await prisma.student.create({
      data: { personId: person.id, isActive: true }
    });
    
    const course = await prisma.course.create({ data: { name: `Course QA ${Date.now()}`, isActive: true }});
    const season = await prisma.season.create({ data: { name: `Season QA ${Date.now()}`, startDate: new Date('2024-01-01'), endDate: new Date('2024-12-31'), isActive: true }});
    
    const courseSeason = await prisma.courseSeason.create({
      data: {
        courseId: course.id,
        seasonId: season.id,
        status: 'PUBLISHED',
        billingConfig: { billingType: 'BOTH', billingFrequency: 'MONTHLY', recurringFee: 100 }
      }
    });

    const category = await prisma.category.create({ data: { name: 'QA Cat' }});
    const shift = await prisma.shift.create({ data: { name: 'Morning', startTime: '08:00', endTime: '10:00' }});

    const courseSeasonShift = await prisma.courseSeasonShift.create({
      data: { courseSeasonId: courseSeason.id, categoryId: category.id, shiftId: shift.id, maxMembers: 10 }
    });

    const event = await prisma.event.create({
      data: {
        title: 'Clase QA',
        startDate: new Date('2024-02-15T10:00:00Z'),
        endDate: new Date('2024-02-15T12:00:00Z'),
        isAllDay: false,
        eventType: 'TRAINING'
      }
    });
    const sessionRecord = await prisma.session.create({
      data: { eventId: event.id, durationMin: 120 }
    });
    await prisma.sessionCourse.create({
      data: { sessionId: sessionRecord.id, courseSeasonShiftId: courseSeasonShift.id }
    });

    console.log(`✓ Datos preparados. StudentID: ${student.id}`);

    // PRUEBA 1
    console.log("\n--- PRUEBA 1: INSCRIPCIÓN INICIAL ---");
    const startedAt = new Date('2024-02-01T10:00:00Z');
    
    const createRes = await fetchAPI(`${API_URL}/student-memberships`, {
      method: 'POST',
      body: JSON.stringify({
        studentId: student.id,
        courseSeasonId: courseSeason.id,
        courseSeasonShiftId: courseSeasonShift.id,
        paymentPlanId: plan.id,
        startedAt: startedAt.toISOString(),
        chargeRegistration: false,
        chargeInitialCycle: true
      })
    });
    
    const membershipId = createRes.data.data.id;
    console.log(`✓ Membresía creada: ${membershipId}`);

    const m1 = await prisma.studentMembership.findUnique({
      where: { id: membershipId },
      include: { cycleEnrollments: true, studentCharges: { include: { charge: true } } }
    });

    console.log(`  - Status: ${m1.status} (Esperado: ACTIVE)`);
    console.log(`  - Ciclos: ${m1.cycleEnrollments.length} (Esperado: 1)`);
    console.log(`  - Ciclo Status: ${m1.cycleEnrollments[0].status} (Esperado: PENDING)`);
    console.log(`  - Charge Status: ${m1.studentCharges[0].charge.status} (Esperado: PENDING)`);

    // PRUEBA 4
    console.log("\n--- PRUEBA 4: ASISTENCIA BLOQUEADA (PENDING) ---");
    try {
      await fetchAPI(`${API_URL}/session-bookings`, {
        method: 'POST',
        body: JSON.stringify({
          sessionId: sessionRecord.id,
          studentId: student.id,
          isExternal: false,
          attended: true
        })
      });
      console.log("❌ ERROR: El backend permitió la asistencia con ciclo PENDING");
    } catch (e: any) {
      if (e.response?.status === 403) {
        console.log(`✓ Backend rechazó correctamente: ${e.response.data.message}`);
      } else {
        throw e;
      }
    }

    // PRUEBA 2
    console.log("\n--- PRUEBA 2: PAGO DEL PRIMER CICLO ---");
    const chargeId = m1.studentCharges[0].charge.id;
    
    await fetchAPI(`${API_URL}/charges/${chargeId}`, { method: 'PATCH', body: JSON.stringify({ amount: 10 }) }); 
    
    let m2 = await prisma.studentMembership.findUnique({
      where: { id: membershipId }, include: { cycleEnrollments: true, studentCharges: { include: { charge: true } } }
    });
    console.log(`  - Después de pago parcial, Ciclo Status: ${m2.cycleEnrollments[0].status} (Esperado: PENDING)`);
    
    const pendingAmount = m2.studentCharges[0].charge.pendingAmount;
    await fetchAPI(`${API_URL}/charges/${chargeId}`, { method: 'PATCH', body: JSON.stringify({ amount: Number(pendingAmount) }) }); 
    
    m2 = await prisma.studentMembership.findUnique({
      where: { id: membershipId }, include: { cycleEnrollments: true, studentCharges: { include: { charge: true } } }
    });
    console.log(`  - Después de pago total, Charge Status: ${m2.studentCharges[0].charge.status} (Esperado: PAID)`);
    console.log(`  - Después de pago total, Ciclo Status: ${m2.cycleEnrollments[0].status} (Esperado: CONFIRMED)`);

    // PRUEBA 3
    console.log("\n--- PRUEBA 3: ASISTENCIA CON CONFIRMED ---");
    const bookingRes = await fetchAPI(`${API_URL}/session-bookings`, {
      method: 'POST',
      body: JSON.stringify({
        sessionId: sessionRecord.id,
        studentId: student.id,
        isExternal: false,
        attended: true
      })
    });
    console.log(`✓ Asistencia registrada exitosamente! BookingID: ${bookingRes.data.data.id}`);
    
    await fetchAPI(`${API_URL}/session-bookings/${bookingRes.data.data.id}`, { method: 'DELETE' });
    console.log(`✓ Asistencia eliminada exitosamente.`);

    // PRUEBA 5
    console.log("\n--- PRUEBA 5: GAP (Expiración del ciclo) ---");
    await prisma.cycleEnrollment.update({
      where: { id: m2.cycleEnrollments[0].id },
      data: { cycleStartDate: new Date('2024-01-01'), cycleEndDate: new Date('2024-01-31') }
    });
    console.log(`✓ Ciclo retrocedido al pasado. Estado real en BD: ACTIVE pero sin ciclo actual.`);

    // PRUEBA 6
    console.log("\n--- PRUEBA 6: COMPRAR NUEVO CICLO ---");
    const advanceRes = await fetchAPI(`${API_URL}/student-memberships/${membershipId}/advance-cycles`, {
      method: 'POST', body: JSON.stringify({ quantity: 1 })
    });
    console.log(`✓ Resultado compra: ${advanceRes.data.message}`);

    const m3 = await prisma.studentMembership.findUnique({
      where: { id: membershipId }, include: { cycleEnrollments: { orderBy: { cycleStartDate: 'desc' } }, studentCharges: { include: { charge: true } } }
    });
    console.log(`  - Membresía Status: ${m3.status} (Esperado: ACTIVE)`);
    console.log(`  - Total Ciclos: ${m3.cycleEnrollments.length} (Esperado: 2)`);
    console.log(`  - Nuevo Ciclo Status: ${m3.cycleEnrollments[0].status} (Esperado: PENDING)`);

    // PRUEBA 14
    console.log("\n--- PRUEBA 14: ANTI-DUPLICADO ---");
    try {
      await fetchAPI(`${API_URL}/student-memberships/${membershipId}/advance-cycles`, { method: 'POST', body: JSON.stringify({ quantity: 1 }) });
      console.log(`✓ Permitió comprar el *siguiente* ciclo futuro, no duplicó.`);
    } catch (e: any) {
      console.log(`✓ Bloqueó correctamente si intentó duplicar: ${e.response?.data?.message}`);
    }

    // PRUEBA 9
    console.log("\n--- PRUEBA 9: SUSPENDED ---");
    const chargeId3 = m3.cycleEnrollments[0].chargeId;
    await prisma.charge.update({ where: { id: chargeId3 }, data: { status: 'PAID', pendingAmount: 0 } });
    await prisma.cycleEnrollment.update({ where: { id: m3.cycleEnrollments[0].id }, data: { status: 'CONFIRMED' } });
    
    await fetchAPI(`${API_URL}/student-memberships/${membershipId}/suspend`, { method: 'PATCH', body: JSON.stringify({ reason: 'Test' }) });
    const m4 = await prisma.studentMembership.findUnique({ where: { id: membershipId } });
    console.log(`  - Status después de suspender: ${m4.status} (Esperado: SUSPENDED)`);

    try {
      const currentCycle = m3.cycleEnrollments[0];
      const sessionNewDate = new Date(currentCycle.cycleStartDate);
      sessionNewDate.setDate(sessionNewDate.getDate() + 2);

      const event2 = await prisma.event.create({
        data: { title: 'Clase QA 2', startDate: sessionNewDate, endDate: sessionNewDate, isAllDay: false, eventType: 'TRAINING' }
      });
      const sessionRecord2 = await prisma.session.create({ data: { eventId: event2.id, durationMin: 120 } });
      await prisma.sessionCourse.create({ data: { sessionId: sessionRecord2.id, courseSeasonShiftId: courseSeasonShift.id } });

      await fetchAPI(`${API_URL}/session-bookings`, {
        method: 'POST', body: JSON.stringify({ sessionId: sessionRecord2.id, studentId: student.id, isExternal: false, attended: true })
      });
      console.log("❌ ERROR: El backend permitió la asistencia estando SUSPENDED");
    } catch (e: any) {
      if (e.response?.status === 403) {
        console.log(`✓ Backend rechazó asistencia por SUSPENDED correctamente: ${e.response.data.message}`);
      } else {
        throw e;
      }
    }

    // PRUEBA 10
    console.log("\n--- PRUEBA 10: REINGRESO ---");
    await fetchAPI(`${API_URL}/student-memberships/${membershipId}/reactivate`, { method: 'PATCH', body: JSON.stringify({ reason: 'Resume test' }) });
    const m5 = await prisma.studentMembership.findUnique({ where: { id: membershipId } });
    console.log(`  - Status después de reactivar: ${m5.status} (Esperado: ACTIVE)`);

    await fetchAPI(`${API_URL}/student-memberships/${membershipId}/withdraw`, { method: 'PATCH', body: JSON.stringify({ reason: 'Test withdraw' }) });
    const m6 = await prisma.studentMembership.findUnique({ where: { id: membershipId } });
    console.log(`  - Status después de withdraw: ${m6.status} (Esperado: WITHDRAWN)`);

    await fetchAPI(`${API_URL}/student-memberships/${membershipId}/reactivate`, { method: 'PATCH', body: JSON.stringify({ reason: 'Reingreso test' }) });
    const m7 = await prisma.studentMembership.findUnique({ where: { id: membershipId } });
    console.log(`  - Status después de reingreso: ${m7.status} (Esperado: ACTIVE)`);

    console.log("\n=== VALIDACIÓN QA COMPLETADA EXITOSAMENTE ===");
    
  } catch (error: any) {
    console.error("❌ ERROR EN QA:");
    if (error.response) {
      console.error(error.response.data);
    } else {
      console.error(error);
    }
  } finally {
    await prisma.$disconnect();
  }
}

runQA();


