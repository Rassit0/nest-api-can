import { PrismaClient, StudentMembershipStatus, StudentMembershipSuspensionReason } from '../src/generated/prisma/client';

const prisma = new PrismaClient();

async function main() {
  console.log('Migrating existing SUSPENDED memberships to use suspensionReason...');

  const resultPause = await prisma.studentMembership.updateMany({
    where: {
      status: StudentMembershipStatus.SUSPENDED,
      suspensionReason: null,
      notes: { contains: 'Pausa' }, // This matches "Pausa iniciada automáticamente" and "Suspendida automáticamente por pausa programada"
    },
    data: {
      suspensionReason: StudentMembershipSuspensionReason.PAUSE,
    },
  });
  console.log(`Updated ${resultPause.count} records to PAUSE`);

  const resultManual = await prisma.studentMembership.updateMany({
    where: {
      status: StudentMembershipStatus.SUSPENDED,
      suspensionReason: null,
    },
    data: {
      suspensionReason: StudentMembershipSuspensionReason.MANUAL,
    },
  });
  console.log(`Updated ${resultManual.count} records to MANUAL`);
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
