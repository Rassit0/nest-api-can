model Staff {
  id                  String               @id @default(uuid())
  personId            String               @unique @map("person_id")
  person              Person               @relation(fields: [personId], references: [id])
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  teamSeasonStaffs    TeamSeasonStaff[]
  courseSeasonStaffs  CourseSeasonStaff[]
  progressEvaluations ProgressEvaluation[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@map("staff")
}

enum TeamSeasonStaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  ASSISTANT
  VOLUNTEER
  DELEGATE
  OTHER
}

model TeamSeasonStaff {
  id String @id @default(uuid())

  teamSeasonId String @map("team_season_id")
  staffId      String @map("staff_id")

  role       TeamSeasonStaffRole
  // Si el rol es OTHER, se especifica en customRole
  customRole String?             @map("custom_role")

  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  // Si es el encargado del equipo
  isPrimary Boolean @default(false) @map("is_primary")

  notes String?

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@map("team_season_staff")
}

// =================================
// FIN STAFF Y EQUIPOS
// =================================

// =================================
// CARGOS
// =================================
enum StatusCharge {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum ChargeDirection {
  RECEIVABLE
  PAYABLE
}

enum ChargeCategory {
  NORMAL
  LATE_FEE
  REGISTRATION
}

model Charge {
  id String @id @default(uuid())

  // Relacion para saber si un cargo es hijo de otro(Ej. Un cargo de mensualidad puede tener recargos por retraso)
  parentChargeId String?
  parentCharge   Charge?  @relation("ChargeParent", fields: [parentChargeId], references: [id])
  childCharges   Charge[] @relation("ChargeParent")

  description   String?
  amount        Decimal @db.Decimal(10, 2)
  pendingAmount Decimal @map("pending_amount") @db.Decimal(10, 2)

  // Descuentos aplicados específicamente a este cargo
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountReason String? @map("discount_reason")

  dueDate        DateTime        @map("due_date") // Fecha donde vencé el cargo, se puede utilizar para calcular recargos si es de mensualidades
  status         StatusCharge    @default(PENDING)
  direction      ChargeDirection @default(RECEIVABLE)
  chargeCategory ChargeCategory  @default(NORMAL) @map("charge_category")

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  membershipCharges MembershipCharge[]

  sessionBooking SessionBooking?
  studentCharges StudentCharge[]
  accountCharge  AccountCharge?

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  payments        Payment[]
  cycleEnrollment CycleEnrollment?

  @@unique([parentChargeId, chargeCategory])
  @@map("charges")
}

model Payment {
  id       String @id @default(uuid())
  chargeId String @map("charge_id")
  charge   Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  receiptSeries String   @map("receipt_series")
  receiptNumber Int      @map("receipt_number")
  amount        Decimal  @db.Decimal(10, 2)
  status        String   @default("COMPLETED")
  paymentDate   DateTime @default(now()) @map("payment_date")

  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([receiptSeries, receiptNumber])
  @@map("payments")
}

// =================================
// FIN CARGOS
// =================================
// =================================
// TRANSACCIONES Y CUENTAS FINANCIERAS
// =================================

enum FinancialAccountType {
  CASH
  BANK
  DIGITAL_WALLET
}

model FinancialAccount {
  id          String               @id @default(uuid())
  name        String
  description String?
  type        FinancialAccountType
  currency    String               @default("BOB")

  cachedBalance    Decimal   @default(0) @map("cached_balance") @db.Decimal(10, 2)
  isDefault        Boolean   @default(false) @map("is_default")
  accountNumber    String?   @map("account_number")
  lastReconciledAt DateTime? @map("last_reconciled_at")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allowedPaymentMethods PaymentMethod[] @default([]) @map("allowed_payment_methods")

  transactions Transaction[]
  cashClosures CashClosure[]

  @@map("financial_accounts")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  QR
  TRANSFER
  CASH
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Transaction {
  id              String          @id @default(uuid())
  receiptSeries   String          @default("GEN") @map("receipt_series")
  receiptNumber   Int             @map("receipt_number")
  payerPersonId   String?         @map("payer_person_id")
  payerPerson     Person?         @relation(fields: [payerPersonId], references: [id])
  amount          Decimal         @db.Decimal(10, 2)
  transactionDate DateTime        @map("transaction_date")
  description     String?
  type            TransactionType
  paymentMethod   PaymentMethod   @map("payment_method")
  reference       String?         @map("reference_number")
  notes           String?

  // Financial Account Relation
  financialAccountId String           @map("financial_account_id")
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])

  // Payment Link (New Architecture)
  paymentId String?  @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  // Transfers & Reconciliations
  referenceGroupId       String?           @map("reference_group_id")
  isReconciled           Boolean           @default(false) @map("is_reconciled")
  reconciledAt           DateTime?         @map("reconciled_at")
  status                 TransactionStatus @default(COMPLETED)
  attachments            Attachment[]
  thirdPartyId           String?           @map("third_party_id")
  thirdParty             ThirdParty?       @relation(fields: [thirdPartyId], references: [id])
  isInternalTransfer     Boolean           @default(false) @map("is_internal_transfer")
  internalTransferSource InternalTransfer? @relation("TransferSource")
  internalTransferDest   InternalTransfer? @relation("TransferDestination")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([receiptSeries, receiptNumber])
  @@map("transactions")
}

// =================================
// TRANSFERENCIAS INTERNAS
// =================================

model InternalTransfer {
  id          String         @id @default(uuid())
  amount      Decimal        @db.Decimal(10, 2)
  description String?
  reference   String?
  status      TransferStatus @default(COMPLETED)
  date        DateTime       @default(now())

  // Relaciones
  sourceTransactionId      String @unique @map("source_transaction_id")
  destinationTransactionId String @unique @map("destination_transaction_id")

  sourceTransaction      Transaction @relation("TransferSource", fields: [sourceTransactionId], references: [id], onDelete: Restrict)
  destinationTransaction Transaction @relation("TransferDestination", fields: [destinationTransactionId], references: [id], onDelete: Restrict)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedByTransfer", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internal_transfers")
}

// =================================
// SECUENCIAS DE RECIBOS/TRANSACCIONES
// =================================
model ReceiptSequence {
  id          String   @id @default(uuid())
  series      String   @unique // Ej: "EQ", "CU", "GEN"
  description String?
  lastValue   Int      @default(0) @map("last_value")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("receipt_sequences")
}

