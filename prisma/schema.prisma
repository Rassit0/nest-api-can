// =================================
// MOTOR DE DISPONIBILIDAD Y CALENDARIO
// =================================
enum EventType {
  SESSION
  MATCH
  GENERAL
  UNAVAILABLE // Bloqueos operativos
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EventSeriesStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum EventExceptionType {
  NONE
  MOVED
  MODIFIED
  CANCELLED
}

model EventSeries {
  id             String @id @default(uuid())
  recurrenceRule String @map("recurrence_rule")
  timezone       String

  eventType       EventType @map("event_type")
  templateData    Json      @map("template_data")
  templateVersion Int       @default(1) @map("template_version")

  materializedUntil  DateTime          @map("materialized_until")
  lastMaterializedAt DateTime?         @map("last_materialized_at")
  status             EventSeriesStatus @default(ACTIVE)
  lockedUntil        DateTime?         @map("locked_until")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  events Event[]

  @@map("event_series")
}

model Event {
  id          String   @id @default(uuid())
  title       String?
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  eventType EventType   @map("event_type")
  status    EventStatus @default(SCHEDULED)

  // Metadatos UI y Recurrencia Materializada
  color String?

  eventSeriesId     String?            @map("event_series_id")
  eventSeries       EventSeries?       @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  originalStartDate DateTime?          @map("original_start_date")
  exceptionType     EventExceptionType @default(NONE) @map("exception_type")

  // Relaciones hacia los contextos (Exclusive Arcs)
  session      Session?
  match        Match?
  generalEvent GeneralEvent?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("EventUpdatedBy", fields: [updatedById], references: [id])

  @@unique([eventSeriesId, originalStartDate])
  // Índices para O(1)
  @@index([locationId, startDate, endDate])
  @@index([startDate, endDate])
  @@index([eventSeriesId])
  @@map("events")
}

// =================================
// CONTEXTOS DE EVENTOS
// =================================
model GeneralEvent {
  id      String @id @default(uuid())
  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Integridad referencial con contextos
  institutionId       String?            @map("institution_id")
  institution         Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teamSeasonId        String?            @map("team_season_id")
  teamSeason          TeamSeason?        @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade)
  courseSeasonId      String?            @map("course_season_id")
  courseSeason        CourseSeason?      @relation(fields: [courseSeasonId], references: [id], onDelete: Cascade)
  courseSeasonShiftId String?            @map("course_season_shift_id")
  courseSeasonShift   CourseSeasonShift? @relation(fields: [courseSeasonShiftId], references: [id], onDelete: Cascade)

  @@map("general_events")
}

model Session {
  id      String @id @default(uuid())
  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  durationMin Int @default(90) @map("duration_min")

  sessionTeams   SessionTeam[]
  sessionCourses SessionCourse[]
  bookings       SessionBooking[]

  @@map("sessions")
}

model SessionTeam {
  sessionId    String
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamSeasonId String     @map("team_season_id")
  teamSeason   TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Restrict)

  @@id([sessionId, teamSeasonId])
  @@map("session_teams")
}

model SessionCourse {
  sessionId           String
  session             Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseSeasonShiftId String            @map("course_season_shift_id")
  courseSeasonShift   CourseSeasonShift @relation(fields: [courseSeasonShiftId], references: [id], onDelete: Restrict)

  @@id([sessionId, courseSeasonShiftId])
  @@map("session_courses")
}

model SessionBooking {
  id        String  @id @default(uuid())
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  playerId  String?  @map("player_id")
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  studentId String?  @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)

  isExternal Boolean @default(false) @map("is_external")
  attended   Boolean @default(false)

  chargeId String? @unique @map("charge_id")
  charge   Charge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incidents SessionIncident[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([sessionId, playerId])
  @@unique([sessionId, studentId])
  @@map("session_bookings")
}

enum MatchType {
  FRIENDLY
  LEAGUE
  TOURNAMENT
  CUP
}

enum MatchResult {
  WIN
  LOSS
  DRAW
  PENDING
}

model Match {
  id      String @id @default(uuid())
  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  teamSeasonId String     @map("team_season_id")
  teamSeason   TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Restrict)

  opponentName String    @map("opponent_name")
  type         MatchType @default(LEAGUE)

  ourScore   Int?        @map("our_score")
  theirScore Int?        @map("their_score")
  result     MatchResult @default(PENDING)

  lineups MatchLineup[]

  @@map("matches")
}

model MatchLineup {
  id       String @id @default(uuid())
  matchId  String @map("match_id")
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  minutesPlayed Int     @default(0) @map("minutes_played")
  goals         Int     @default(0)
  assists       Int     @default(0)
  yellowCards   Int     @default(0) @map("yellow_cards")
  redCards      Int     @default(0) @map("red_cards")
  isStarter     Boolean @default(false) @map("is_starter")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([matchId, playerId])
  @@map("match_lineups")
}

model AuditLog {
  id         String @id @default(uuid())
  entityName String @map("entity_name")
  entityId   String @map("entity_id")
  action     String // CREATE, UPDATE, DELETE

  // === Campos para el Dashboard e i18n ===
  type          String? // Ej: "SUCCESS", "INFO", "WARNING" o módulos
  titleKey      String? @map("title_key") // Ej: "audit.title.enrollment"
  messageKey    String? @map("message_key") // Ej: "audit.message.enrollment"
  messageParams Json?   @map("message_params") // Ej: { "player": "Facundo", "team": "Básquet U17" }

  // === Campos de auditoría ===
  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model EventMaterializationLog {
  id            String   @id @default(uuid())
  eventSeriesId String   @map("event_series_id")
  generatedDate DateTime @map("generated_date")
  status        String
  errorCode     String?  @map("error_code")
  metadata      Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("event_materialization_logs")
}

// =================================
// CUENTAS UNIFICADAS (COBRAR Y PAGAR) - (Extension de Charge)
// =================================

enum AccountReferenceType {
  PURCHASE_ORDER
  CONTRACT
  EVENT
  EQUIPMENT
  OTHER
}

model AccountCategory {
  id            String  @id @default(uuid())
  code          String  @unique @map("code")
  name          String
  description   String?
  receiptSeries String? @map("receipt_series")
  isSystem      Boolean @default(false) @map("is_system")
  isActive      Boolean @default(true) @map("is_active")

  // Para saber si la categoría es mayormente de gastos o ingresos (opcional)
  type ChargeDirection

  parentId String?           @map("parent_id")
  parent   AccountCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AccountCategory[] @relation("CategoryHierarchy")

  accountCharges AccountCharge[]
  schools        School[]        @relation("SchoolDefaultCategory")
  clubs          Club[]          @relation("ClubDefaultCategory")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@map("account_categories")
}

model AccountCharge {
  id String @id @default(uuid())

  // Relación 1 a 1 con Charge
  chargeId String @unique @map("charge_id")
  charge   Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  title String

  categoryId String?          @map("category_id")
  category   AccountCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  referenceType   AccountReferenceType? @map("reference_type")
  referenceId     String?               @map("reference_id")
  referenceNumber String?               @map("reference_number")

  // A quién se le debe o quién nos debe
  personId String? @map("person_id")
  person   Person? @relation("PersonAccountCharges", fields: [personId], references: [id])

  externalEntity String? @map("external_entity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@index([personId])
  @@index([categoryId])
  @@map("account_charges")
}

model CashClosure {
  id                 String           @id @default(uuid())
  financialAccountId String           @map("financial_account_id")
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  closedAt        DateTime @default(now()) @map("closed_at")
  expectedBalance Decimal  @map("expected_balance") @db.Decimal(12, 2)
  actualBalance   Decimal  @map("actual_balance") @db.Decimal(12, 2)
  difference      Decimal  @map("difference") @db.Decimal(12, 2)

  observations String? @db.Text

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedByCashClosure", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedByCashClosure", fields: [updatedById], references: [id])

  @@index([financialAccountId, closedAt(sort: Desc)])
  @@map("cash_closures")
}

enum ThirdPartyType {
  PROVIDER
  CLIENT
  INSTITUTION
  OTHER
}

model ThirdParty {
  id             String         @id @default(uuid())
  name           String
  type           ThirdPartyType @default(PROVIDER)
  documentType   String?        @map("document_type")
  documentNumber String?        @map("document_number")
  contactEmail   String?        @map("contact_email")
  contactPhone   String?        @map("contact_phone")
  transactions   Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("third_parties")
}

enum AttachmentStatus {
  PENDING
  LINKED
  DELETED
}

model Attachment {
  id           String  @id @default(uuid())
  originalName String  @map("original_name")
  internalName String  @unique @map("internal_name")
  mimeType     String  @map("mime_type")
  sizeBytes    Int     @map("size_bytes")
  url          String?
  path         String?

  status AttachmentStatus @default(PENDING)

  // Exclusive Arcs for polymorphic associations
  transactionId String?      @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Future associations:
  // personId   String?      @map("person_id")
  // person     Person?      @relation(fields: [personId], references: [id], onDelete: Cascade)

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([transactionId])
  @@map("attachments")
}
