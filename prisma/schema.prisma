model Role {
  id          String  @id @default(uuid())
  name        String  @unique // Ej: "ADMIN", "COACH", "PARENT", "PLAYER"
  description String?

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@map("roles")
}

model Module {
  id          String  @id @default(uuid())
  name        String  @unique // Ej: "BILLING", "TEAMS", "SESSIONS"
  displayName String  @map("display_name") // Ej: "Facturación y Cobranza"
  icon        String? // Ej: "FiDollarSign" para el menú del frontend
  sortOrder   Int     @default(0) @map("sort_order")
  description String?

  permissions Permission[] // Relación 1:N con los permisos

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("modules")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // Ej: "TAKE_ATTENDANCE", "CREATE_INCIDENT", "VIEW_PAYMENTS"
  description String?

  moduleId String @map("module_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =================================
// ESCUELAS Y CURSOS
// =================================
model School {
  id            String      @id @default(uuid())
  name          String
  shortName     String?     @map("short_name")
  institutionId String      @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  disciplineId  String      @map("discipline_id")
  discipline    Discipline  @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  defaultAccountCategoryId String?          @map("default_account_category_id")
  defaultAccountCategory   AccountCategory? @relation("SchoolDefaultCategory", fields: [defaultAccountCategoryId], references: [id], onDelete: Restrict)

  courses Course[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([institutionId, disciplineId, name])
  @@map("schools")
}

model Course {
  id            String         @id @default(uuid())
  imageUrl      String?        @map("image_url")
  name          String
  shortName     String?        @map("short_name")
  description   String?
  schoolId      String         @map("school_id")
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  courseSeasons CourseSeason[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([schoolId, name])
  @@map("courses")
}

enum StatusCourseSeason {
  DRAFT
  ACTIVE
  FINISHED
  CANCELLED
}

model CourseSeason {
  id          String  @id @default(uuid())
  name        String  @default("Regular")
  imageUrl    String? @map("image_url")
  description String?

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  status      StatusCourseSeason @default(DRAFT)
  statusNotes String?            @map("status_notes") @db.Text

  isRegistrationOpen Boolean @default(true) @map("is_registration_open")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shifts             CourseSeasonShift[]
  studentMemberships StudentMembership[]
  cycleEnrollments   CycleEnrollment[]
  paymentPlans       PaymentPlan[]
  generalEvents      GeneralEvent[]
  billingConfig      CourseSeasonBillingConfig?
  pauses             CourseSeasonPause[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([courseId, seasonId, name])
  @@map("course_seasons")
}

model CourseSeasonShift {
  id             String       @id @default(uuid())
  courseSeasonId String       @map("course_season_id")
  courseSeason   CourseSeason @relation(fields: [courseSeasonId], references: [id], onDelete: Cascade)
  shiftId        String       @map("shift_id")
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  maxMembers Int           @map("max_members")
  minMembers Int           @map("min_members")
  categoryId String        @map("category_id")
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  gender     ProgramGender

  minBirthYear Int? @map("min_birth_year")
  maxBirthYear Int? @map("max_birth_year")

  validateAge Boolean @default(true) @map("validate_age")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentMemberships StudentMembership[]
  cycleEnrollments   CycleEnrollment[]
  courseSeasonStaffs CourseSeasonStaff[]
  sessionCourses     SessionCourse[]
  pauses             CourseSeasonPause[]
  generalEvents      GeneralEvent[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@unique([courseSeasonId, shiftId])
  @@unique([id, courseSeasonId])
  @@map("course_season_shifts")
}

model TeamSeasonPause {
  id           String     @id @default(uuid())
  teamSeasonId String     @map("team_season_id")
  teamSeason   TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade)
  startDate    DateTime   @map("start_date")
  endDate      DateTime   @map("end_date")
  reason       String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@map("team_season_pauses")
}

model CourseSeasonPause {
  id                  String             @id @default(uuid())
  courseSeasonId      String             @map("course_season_id")
  courseSeason        CourseSeason       @relation(fields: [courseSeasonId], references: [id], onDelete: Cascade)
  courseSeasonShiftId String?            @map("course_season_shift_id")
  courseSeasonShift   CourseSeasonShift? @relation(fields: [courseSeasonShiftId], references: [id], onDelete: Cascade)
  startDate           DateTime           @map("start_date")
  endDate             DateTime           @map("end_date")
  reason              String?            @db.Text
  createdAt           DateTime           @default(now()) @map("created_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  @@map("course_season_pauses")
}

model CourseSeasonBillingConfig {
